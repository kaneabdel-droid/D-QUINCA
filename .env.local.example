# Copier en .env.local et remplir avec les clés du projet Supabase dédié à D-QUINCA
# (jamais celui de SIGGIE — chaque produit a son propre projet Supabase, cf. plan §0).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Origine publique utilisée dans le lien de réinitialisation de mot de passe
# (app/forgot-password/actions.ts). En local : http://localhost:3000 (valeur par
# défaut si absent). En production, doit pointer vers le domaine réel du produit.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Emails autorisés à se connecter sur /admin (séparés par des virgules).
ADMIN_EMAILS=kaneabdel@gmail.com

# Identité admin partagée entre produits DembaSolution (SSO) — clés du projet
# Supabase de SIGGIE (source d'identité admin commune), pas celles de D-QUINCA
# ci-dessus. Voir utils/supabase/admin-identity.ts.
ADMIN_IDENTITY_SUPABASE_URL=
ADMIN_IDENTITY_SUPABASE_ANON_KEY=

# ── Paiement des abonnements (lib/abonnements/*) ──────────────────────────
# Provider actif : chariow (par défaut) | moneroo | bictorys. Ne pas basculer
# vers moneroo/bictorys tant que leurs clés ci-dessous ne sont pas renseignées.
PAYMENT_PROVIDER_ACTIF=chariow

# Chariow — un produit par combinaison palier×durée doit exister dans la
# boutique Chariow, avec le prix exact calculé par lib/abonnements/paliers.ts
# (calculerMontantFcfa), remise 6/12 mois déjà intégrée au prix du produit :
#   standard : 5000 / 28500 (6 mois, -5%) / 54000 (12 mois, -10%)
#   medium   : 7500 / 42750 / 81000
#   premium  : 10000 / 57000 / 108000
CHARIOW_API_KEY=
CHARIOW_API_URL=https://api.chariow.com/v1
CHARIOW_WEBHOOK_SECRET=
CHARIOW_PRODUCT_STANDARD_1=
CHARIOW_PRODUCT_STANDARD_6=
CHARIOW_PRODUCT_STANDARD_12=
CHARIOW_PRODUCT_MEDIUM_1=
CHARIOW_PRODUCT_MEDIUM_6=
CHARIOW_PRODUCT_MEDIUM_12=
CHARIOW_PRODUCT_PREMIUM_1=
CHARIOW_PRODUCT_PREMIUM_6=
CHARIOW_PRODUCT_PREMIUM_12=

# Moneroo — pas encore actif (en attente des clés). Accepte un montant libre :
# pas de produits à préconfigurer, contrairement à Chariow.
MONEROO_API_KEY=
MONEROO_WEBHOOK_SECRET=

# Bictorys — pas encore actif (en attente des clés).
BICTORYS_API_KEY=
BICTORYS_WEBHOOK_SECRET=
BICTORYS_MERCHANT_COUNTRY=SN

# Protège GET /api/cron/abonnements (réconciliation + suspension des comptes
# expirés, cf. vercel.json). Vercel Cron l'ajoute automatiquement en
# `Authorization: Bearer $CRON_SECRET` quand cette variable est définie.
CRON_SECRET=
