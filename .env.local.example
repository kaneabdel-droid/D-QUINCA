# Copier en .env.local et remplir avec les clés du projet Supabase dédié à D-QUINCA
# (jamais celui de SIGGIE — chaque produit a son propre projet Supabase, cf. plan §0).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Origine publique utilisée dans le lien de réinitialisation de mot de passe
# (app/forgot-password/actions.ts). En local : http://localhost:3000 (valeur par
# défaut si absent). En production, doit pointer vers le domaine réel du produit.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Emails autorisés à se connecter sur /admin (séparés par des virgules).
ADMIN_EMAILS=kaneabdel@gmail.com
